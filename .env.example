# Review Hub 凭证配置（填好保存为 .env，重启服务生效）

# 旧版单 token 迁移入口；新安装请在「配置中心 → 凭证与模型 → GitHub 连接」添加多个 token，项目逐一绑定。
GITHUB_TOKEN=
# 组织名，用于一键导入全部仓库
GITHUB_ORG=
# 公网部署必填：GitHub Webhook 签名密钥。
WEBHOOK_SECRET=
# 公网地址（可选，本机部署用轮询模式即可；配了才能自动挂 webhook）
# 例：PUBLIC_BASE_URL=https://xxxx.trycloudflare.com
PUBLIC_BASE_URL=
# 公网部署必填：HTTP Basic 管理员凭据。通过 HTTPS 反向代理访问服务。
HUB_ADMIN_USER=admin
HUB_ADMIN_PASSWORD=

# Claude 侧评审：本机已登录 Claude Code 则无需填写；否则给 API key
# CLAUDE_CODE_OAUTH_TOKEN=
# ANTHROPIC_API_KEY=

# Kimi（Moonshot）：Codex 侧评审的后端模型
# run.sh 会据此在 data/codex-home 生成桥接配置（Responses API）
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=kimi-k2.7-code

# 轮询间隔秒数（无公网时靠它发现 push/PR）
POLL_INTERVAL=30
HUB_PORT=7777

# 并发审查 worker 数（默认 2）：多项目同时审查；门禁 Docker 沙盒模式下资源互不影响
WORKER_CONCURRENCY=2
# 每个交叉评审组同时运行的评审器数，默认 4，最大 4；总并发上限约为两者乘积
REVIEW_CONCURRENCY=4
# 仅测试或 API 副本设为 0；常规服务保持 1。
HUB_BACKGROUND=1
